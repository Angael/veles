{
  "name": "veles",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @veles/web dev",
    "dev:web": "pnpm --filter @veles/web dev",
    "dev:worker": "pnpm --filter @veles/worker dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --filter @veles/web start",
    "test": "pnpm --recursive test",
    "lint:css": "pnpm --filter @veles/web lint:css",
    "lint:css:fix": "pnpm --filter @veles/web lint:css:fix",
    "typecheck": "pnpm --recursive typecheck",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "pnpm fmt:check && pnpm lint:css && pnpm typecheck && pnpm test",
    "check:fix": "pnpm fmt && pnpm lint:css:fix && pnpm typecheck && pnpm test",
    "db:generate": "pnpm --filter @veles/db db:generate",
    "db:migrate": "pnpm --filter @veles/db db:migrate",
    "db:migrate:prod": "pnpm --filter @veles/db db:migrate:prod",
    "db:push": "pnpm --filter @veles/db db:push",
    "db:reset": "pnpm --filter @veles/db db:reset",
    "db:studio": "pnpm --filter @veles/db db:studio",
    "db:studio:prod": "pnpm --filter @veles/db db:studio:prod"
  },
  "devDependencies": {
    "oxfmt": "0.51.0"
  },
  "engines": {
    "node": ">=26.2.0"
  },
  "packageManager": "pnpm@11.5.0"
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "ignorePatterns": [
    ".agents/**",
    "apps/web/src/routeTree.gen.ts",
    "node_modules/**",
    "**/.output/**"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "args": "all",
        "argsIgnorePattern": "^_"
      }
    ]
  }
}

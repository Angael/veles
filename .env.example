# Runtime environment variables

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veles_dev
PROD_DATABASE_URL=postgresql://user:password@prod-host:5432/veles_prod

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3000
# Comma-separated, exact Google account addresses. Empty means no new accounts.
AUTH_ALLOWED_EMAILS=krzysztofwidacki@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connection invitations
RESEND_API_KEY=
INVITATION_EMAIL_FROM=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Build-time environment variables
VITE_APP_NAME=Veles
# Favicon variant: production, development, or localhost.
VITE_APP_ENV=localhost
VITE_CF_CDN_URL=https://cdn.example.com

# Standalone @veles/preview container (configure in its Dokploy application, not compose.yaml).
GITHUB_REPOSITORY=Angael/veles
GITHUB_MAIN_BRANCH_NAME=main
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# PEM key; literal \n escapes are accepted in one-line Dokploy variables.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
DOKPLOY_URL=https://dokploy.example.com
DOKPLOY_API_KEY=
PREVIEW_ENVIRONMENT_ID=
# Only include provisioned dev Composes, in slot order (first entry is slot 1).
PREVIEW_SLOTS=[{"composeId":"replace-with-dev-compose-id","url":"https://veles-dev1.widacki.me"}]
PREVIEW_DB_PATH=/data/preview.sqlite
# PORT defaults to 3000.
